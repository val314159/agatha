#!/usr/bin/env python3
import sys

from mtd.lib.task_store import connect, dump, get_task, read_payload


def main():
    try:
        payload = read_payload()
        task_id = payload.get("id")
        if not task_id:
            raise ValueError("get_task requires id")
        with connect() as con:
            task = get_task(con, task_id)
        sys.stdout.write(dump(task))
    except Exception as e:
        print(e, file=sys.stderr)
        raise SystemExit(1)


if __name__ == "__main__":
    main()
