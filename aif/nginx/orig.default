            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;

            # Disable buffering so data is sent immediately
            proxy_buffering off;

            # Optional: tune proxy buffer sizes if needed
            proxy_buffers 8 16k;
            proxy_busy_buffers_size 24k;

            # Optional: flush headers immediately
            proxy_ignore_client_abort off;
        }

        location ~ ^/api/(tags|show|generate|chat|embeddings|pull|push|create|delete|history)$ {
            proxy_pass http://127.0.0.1:12434/ollama/$1;

            proxy_http_version 1.1;
            proxy_set_header Connection "";

            proxy_set_header Host 127.0.0.1:11434;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;

            # Disable buffering so data is sent immediately
            proxy_buffering off;

            # Optional: tune proxy buffer sizes if needed
            proxy_buffers 8 16k;
            proxy_busy_buffers_size 24k;

            # Optional: flush headers immediately
            proxy_ignore_client_abort off;
        }

        location /tts/ {
            proxy_pass http://localhost:9009/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
#            proxy_cache_bypass $http_upgrade;

            proxy_http_version 1.1;
            proxy_set_header Connection "";

#            proxy_set_header Host 127.0.0.1:11434;
#            proxy_set_header X-Real-IP $remote_addr;
#            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;

            # Disable buffering so data is sent immediately
            proxy_buffering off;

            # Optional: tune proxy buffer sizes if needed
            proxy_buffers 8 16k;
            proxy_busy_buffers_size 24k;

            # Optional: flush headers immediately
            proxy_ignore_client_abort off;
    }

    location /tts/audiows {
        proxy_pass http://localhost:9009/audiows;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /todo {
        return 301 /todo/;
    }
    location /todo/ {
        proxy_pass http://localhost:8181;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
				
    location = /chat {
        return 301 /chat/;
    }
    location /chat/ {
        proxy_pass http://localhost:1234;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
				
    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/a.ccl.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/a.ccl.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = a.ccl.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


	listen 80 ;
	listen [::]:80 ;
    server_name a.ccl.io;
    return 404; # managed by Certbot


}
